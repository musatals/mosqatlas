{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosque-atlas.example/schema/enriched-profile.v1.schema.json",
  "title": "Mosque Atlas enriched pilot profiles",
  "type": "object",
  "required": ["schema_version", "editorial_status", "profiles"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "editorial_status": {
      "const": "source_linked_editorial_synthesis_pending_scholarly_and_translation_review"
    },
    "profiles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["record_id", "names", "sections"],
        "properties": {
          "record_id": { "type": "string", "pattern": "^MOS-[0-9]{4}$" },
          "names": { "$ref": "#/$defs/localizedStrings" },
          "sections": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["id", "visibility", "content", "source_ids"],
              "properties": {
                "id": { "type": "string", "pattern": "^MOS-[0-9]{4}-[0-9]{2}$" },
                "visibility": { "enum": ["visitor_and_research", "research_only"] },
                "content": {
                  "type": "object",
                  "required": ["en", "fr", "ar"],
                  "properties": {
                    "en": { "$ref": "#/$defs/sectionCopy" },
                    "fr": { "$ref": "#/$defs/sectionCopy" },
                    "ar": { "$ref": "#/$defs/sectionCopy" }
                  },
                  "additionalProperties": false
                },
                "source_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^SRC-[A-Z-]+$" }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedStrings": {
      "type": "object",
      "required": ["en", "fr", "ar"],
      "properties": {
        "en": { "type": "string", "minLength": 2 },
        "fr": { "type": "string", "minLength": 2 },
        "ar": { "type": "string", "minLength": 2 }
      },
      "additionalProperties": false
    },
    "sectionCopy": {
      "type": "object",
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 4 },
        "body": { "type": "string", "minLength": 80 }
      },
      "additionalProperties": false
    }
  }
}
