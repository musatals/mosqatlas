{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosque-atlas:schema:mosque-record:1.0.0",
  "title": "MOSQUE ATLAS 3D — verified core record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "names",
    "location",
    "chronology",
    "architectural_profile",
    "heritage",
    "content",
    "claims",
    "source_ids",
    "media",
    "model_3d",
    "editorial",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^MOS-[0-9]{4}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "names": {
      "type": "object",
      "required": [
        "en",
        "fr",
        "ar",
        "original"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        },
        "original": {
          "type": "object",
          "required": [
            "value",
            "language"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2,3}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": [
        "city",
        "country",
        "country_iso2",
        "coordinates"
      ],
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "country_iso2": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "coordinates": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "lat",
                "lon"
              ],
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "chronology": {
      "type": "object",
      "required": [
        "foundation",
        "present_structure",
        "phases"
      ],
      "properties": {
        "foundation": {
          "$ref": "#/$defs/date_claim"
        },
        "present_structure": {
          "$ref": "#/$defs/date_claim"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "architectural_profile": {
      "type": "object",
      "required": [
        "traditions",
        "typologies",
        "materials",
        "elements"
      ],
      "properties": {
        "traditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "typologies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "heritage": {
      "type": "object",
      "required": [
        "relationship",
        "designation_name",
        "inscription_year",
        "unesco_property_id",
        "source_ids",
        "context_note"
      ],
      "properties": {
        "relationship": {
          "enum": [
            "individually_inscribed",
            "original_inscription_later_extended",
            "within_inscribed_property",
            "national_monument",
            "not_verified"
          ]
        },
        "designation_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "inscription_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "unesco_property_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": [
        "en",
        "fr",
        "ar"
      ],
      "properties": {
        "en": {
          "type": "object",
          "required": [
            "intro",
            "history",
            "architecture"
          ],
          "properties": {
            "intro": {
              "type": "string",
              "minLength": 10
            },
            "history": {
              "type": "string",
              "minLength": 10
            },
            "architecture": {
              "type": "string",
              "minLength": 10
            }
          },
          "additionalProperties": false
        },
        "fr": {
          "type": "object",
          "required": [
            "intro",
            "history",
            "architecture"
          ],
          "properties": {
            "intro": {
              "type": "string",
              "minLength": 10
            },
            "history": {
              "type": "string",
              "minLength": 10
            },
            "architecture": {
              "type": "string",
              "minLength": 10
            }
          },
          "additionalProperties": false
        },
        "ar": {
          "type": "object",
          "required": [
            "intro",
            "history",
            "architecture"
          ],
          "properties": {
            "intro": {
              "type": "string",
              "minLength": 10
            },
            "history": {
              "type": "string",
              "minLength": 10
            },
            "architecture": {
              "type": "string",
              "minLength": 10
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement_en",
          "certainty",
          "source_ids",
          "review_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CLM-"
          },
          "statement_en": {
            "type": "string",
            "minLength": 15
          },
          "certainty": {
            "enum": [
              "documented",
              "traditional",
              "disputed",
              "uncertain"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "review_note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      }
    },
    "model_3d": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/model"
        }
      ]
    },
    "editorial": {
      "type": "object",
      "required": [
        "approval",
        "approved_scope",
        "scholarly_peer_review",
        "fr_ar_translation_review",
        "approved_on",
        "image_license_status",
        "model_validation",
        "visitor_access"
      ],
      "properties": {
        "approval": {
          "enum": [
            "editorial_core_fact_checked",
            "research_candidate",
            "scholarly_approved"
          ]
        },
        "approved_scope": {
          "enum": [
            "limited_verified_core",
            "complete_dossier",
            "none"
          ]
        },
        "scholarly_peer_review": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "fr_ar_translation_review": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "approved_on": {
          "type": "string",
          "format": "date"
        },
        "image_license_status": {
          "enum": [
            "no_reuse_cleared",
            "partially_cleared",
            "cleared"
          ]
        },
        "model_validation": {
          "enum": [
            "not_applicable",
            "pending",
            "verified"
          ]
        },
        "visitor_access": {
          "enum": [
            "not_verified",
            "verified"
          ]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "legacy_id",
        "legacy_dataset"
      ],
      "properties": {
        "legacy_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "legacy_dataset": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "date_claim": {
      "type": "object",
      "required": [
        "display",
        "start_year",
        "end_year",
        "precision",
        "certainty",
        "event_type",
        "source_ids",
        "sort_year"
      ],
      "properties": {
        "display": {
          "type": "string",
          "minLength": 3
        },
        "start_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "end_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "precision": {
          "enum": [
            "year",
            "range",
            "century",
            "period",
            "unknown",
            "traditional_century",
            "multi_period"
          ]
        },
        "certainty": {
          "enum": [
            "documented",
            "disputed",
            "traditional",
            "uncertain"
          ]
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sort_year": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "required": [
        "id",
        "event_type",
        "display_date",
        "start_year",
        "end_year",
        "description_en",
        "certainty",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PH-"
        },
        "event_type": {
          "enum": [
            "foundation",
            "initial_construction",
            "early_foundation",
            "extension",
            "reconstruction",
            "modification",
            "change_of_use",
            "heritage_designation"
          ]
        },
        "display_date": {
          "type": "string",
          "minLength": 3
        },
        "start_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "end_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "description_en": {
          "type": "string",
          "minLength": 15
        },
        "certainty": {
          "enum": [
            "documented",
            "traditional",
            "disputed",
            "uncertain"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": [
        "id",
        "role",
        "url",
        "author",
        "license",
        "attribution",
        "rights_verified"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "front",
            "rear",
            "side",
            "aerial",
            "interior",
            "detail",
            "plan",
            "section",
            "historical"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "rights_verified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "uri",
        "format",
        "represented_phase",
        "provenance",
        "license",
        "scale_verified",
        "accuracy_class",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri-reference"
        },
        "format": {
          "enum": [
            "glb",
            "gltf"
          ]
        },
        "represented_phase": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "scale_verified": {
          "type": "boolean"
        },
        "accuracy_class": {
          "enum": [
            "measured",
            "documentary_reconstruction",
            "hypothetical",
            "unverified"
          ]
        },
        "status": {
          "enum": [
            "submitted",
            "reviewed",
            "published"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
